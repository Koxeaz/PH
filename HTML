<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Portfolio Lab 3</title>
    <style>
        /* Basic Reset */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #0d1b2a; /* Deep blue background */
            color: #ffffff;
            line-height: 1.5;
            padding: 20px;
        }

        /* Container */
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        /* Header */
        .header {
            background-color: #1b4965; /* Classic Superman Blue */
            border: 2px solid #ffb703; /* Yellow Border */
            padding: 18px;
            margin-bottom: 18px;
            border-radius: 8px;
            text-align: center;
        }

        .header h1 {
            letter-spacing: 1px;
            font-size: 1.6rem;
            color: #ffffff;
        }

        .highlight {
            color: #ffb703; /* Superman Yellow */
            font-weight: 600;
        }

        /* Main Area Layout */
        .main-area {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        /* Content Box */
        .content {
            flex: 2;
            background-color: #1b4965;
            border: 1px solid #62b6cb;
            padding: 16px;
            border-radius: 6px;
        }

        .content > p {
            margin-top: 12px;
            color: #e0f2fe;
        }

        /* Sidebar Box */
        .sidebar {
            flex: 1;
            background-color: #1b4965;
            border: 1px solid #62b6cb;
            padding: 16px;
            border-radius: 6px;
        }

        .sidebar h3 {
            color: #ffb703;
            margin-bottom: 8px;
        }

        .sidebar ul {
            padding-left: 20px;
        }

        .sidebar a {
            color: #ffffff;
            text-decoration: none;
        }

        .sidebar a:hover {
            color: #ffb703;
            text-decoration: underline;
        }

        /* Profile Card */
        .profile-card {
            display: flex;
            gap: 16px;
            align-items: center;
            border: 2px dashed #ffb703;
            padding: 12px;
            margin-bottom: 14px;
            background-color: #0f2b46;
            border-radius: 6px;
        }

        .profile-info h3 {
            color: #ffb703;
            margin-bottom: 4px;
        }

        .profile-info p {
            color: #d1e8ff;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .contact-details {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid #1b4965;
            font-size: 0.85rem;
        }

        .contact-details a {
            color: #ffb703;
            text-decoration: none;
        }

        .contact-details a:hover {
            text-decoration: underline;
        }

        .avatar {
            width: 96px;
            height: 96px;
            object-fit: cover;
            border-radius: 6px;
            border: 3px solid #ffb703;
        }

        /* Red Contact Button */
        .contact-btn {
            margin-top: 8px;
            padding: 8px 12px;
            border: none;
            border-radius: 4px;
            background-color: #d90429; /* Superman Red */
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        .contact-btn:hover {
            background-color: #ef233c;
        }

        /* Footer */
        .footer {
            text-align: center;
            margin-top: 16px;
            padding: 10px;
            font-size: 0.9rem;
            color: #90e0ef;
        }

        /* Responsive Layout (<700px) */
        @media (max-width: 700px) {
            .main-area {
                flex-direction: column;
            }
            .avatar {
                width: 72px;
                height: 72px;
            }
        }
    </style>
</head>
<body>

    <div class="container">

        <!-- Header -->
        <header class="header">
            <h1>IT Portfolio <span class="highlight">Lab 3</span></h1>
        </header>

        <!-- Main Area (Flexbox Layout) -->
        <div class="main-area">

            <!-- Content (Left Column) -->
            <main class="content">
                
                <!-- Profile Card -->
                <div class="profile-card">
                    <img src="https://m.media-amazon.com/images/M/MV5BOTc4ODA0NzA4OF5BMl5BanBnXkFtZTcwNDA4NTc4Mg@@._V1_.jpg" alt="Profile Avatar" class="avatar">
                    <div class="profile-info">
                        <h3>Rein Charles Tagala</h3>
                        <p><strong>Role:</strong> BSIT Student & Developer</p>
                        <p>Passionate about building modern web applications, exploring CSS layouts, and learning code logic.</p>
                        
                        <!-- Contact Details -->
                        <div class="contact-details">
                            <p><strong>Email:</strong> <a href="mailto:tagalareincharles@gmail.com">tagalareincharles@gmail.com</a></p>
                            <p><strong>Phone:</strong> <a href="tel:09613626635">0961 362 6635</a></p>
                        </div>

                        <button class="contact-btn">Contact Me</button>
                    </div>
                </div>

                <p>Welcome to my portfolio lab! This page demonstrates the use of external CSS, CSS Flexbox layouts, responsive design using media queries, and modular box styling.</p>

            </main>

            <!-- Sidebar (Right Column) -->
            <aside class="sidebar">
                <h3>Quick Links</h3>
                <ul>
                    <li><a href="#">Home</a></li>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Projects</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </aside>

        </div>

        <!-- Footer -->
        <footer class="footer">
            <p>&copy; 2025 — CSIT Lab</p>
        </footer>

    </div>

</body>
</html>
