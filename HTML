/* Reset & Base Styles */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #fffbeb; /* Soft warm cream background */
    color: #1f2937;
    line-height: 1.6;
    padding: 20px;
}

/* Container */
.container {
    max-width: 1000px;
    margin: 0 auto;
}

/* Header */
.header {
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    border: 2px solid #f59e0b;
    padding: 24px;
    margin-bottom: 20px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(245, 158, 11, 0.1);
}

.header h1 {
    letter-spacing: 1.5px;
    font-size: 1.8rem;
    color: #78350f;
}

.highlight {
    color: #d97706;
    font-weight: 700;
    background-color: #fef08a;
    padding: 2px 8px;
    border-radius: 4px;
}

/* Main layout */
.main-area {
    display: flex;
    gap: 20px;
    align-items: flex-start;
}

/* Content */
.content {
    flex: 2;
    background: #ffffff;
    border: 1px solid #fde68a;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.content > p {
    color: #4b5563;
    margin-top: 16px;
    font-size: 0.95rem;
}

/* Sidebar */
.sidebar {
    flex: 1;
    background: #ffffff;
    border: 1px solid #fde68a;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.sidebar h3 {
    color: #78350f;
    margin-bottom: 12px;
    font-size: 1.1rem;
    border-bottom: 2px solid #fef3c7;
    padding-bottom: 6px;
}

.sidebar ul {
    list-style: none;
    padding-left: 0;
}

.sidebar li {
    margin-bottom: 8px;
}

.sidebar a {
    color: #b45309;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
}

.sidebar a:hover {
    color: #d97706;
    text-decoration: underline;
}

/* Profile card */
.profile-card {
    display: flex;
    gap: 20px;
    align-items: center;
    border: 2px dashed #fbbf24;
    padding: 18px;
    background: #fffdf5;
    border-radius: 10px;
}

.profile-info h3 {
    color: #78350f;
    margin-bottom: 4px;
}

.profile-info p {
    color: #4b5563;
    font-size: 0.9rem;
    margin-bottom: 6px;
}

.avatar {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid #f59e0b;
    box-shadow: 0 4px 6px rgba(245, 158, 11, 0.2);
}

/* Button */
.contact-btn {
    margin-top: 10px;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    background: #f59e0b;
    color: #ffffff;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
}

.contact-btn:hover {
    background: #d97706;
    transform: translateY(-1px);
}

/* Footer */
.footer {
    text-align: center;
    margin-top: 24px;
    padding: 12px;
    font-size: 0.85rem;
    color: #92400e;
    border-top: 1px solid #fef3c7;
}

/* Responsive layout */
@media (max-width: 700px) {
    .main-area {
        flex-direction: column;
    }
    .profile-card {
        flex-direction: column;
        text-align: center;
    }
    .avatar {
        width: 88px;
        height: 88px;
    }
}
